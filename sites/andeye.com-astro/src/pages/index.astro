---
// andeye.com - the suite home, in the "Watchful" language of
// time.andeye.com (same palette, type scale, section rhythm and reveal
// choreography), with the BRAND BLUE accent instead of Time's orange:
// this page is the parent brand saying hello, so the hero mark is the
// original blue with an empty iris.
// ALL visible copy lives in src/content/home.md - edit there, not here.
// Hover states change colour only - nothing on this page moves on hover.
import AndeyeEye from '../components/AndeyeEye.astro';
import { frontmatter as fm, Content } from '../content/home.md';
// Per-product hover accent (design, not copy), keyed by the eye variant:
// Time's orange, vibe's white.
const PRODUCT_ACCENT = { time: '#f0a13a', vibe: '#eef1f6' };
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fm.title} – {fm.tagline}</title>
<meta name="description" content={fm.description}>
<link rel="canonical" href="https://andeye.com/">
<style is:global>
  :root {
    --bg: #0c0f16;
    --bg-deep: #090b11;
    --panel: #131826;
    --panel-2: #161c2c;
    --line: #232b40;
    --line-soft: #1b2233;
    --text: #eef1f6;
    --muted: #98a0b3;
    --faint: #6a7382;
    --accent: #56C1FF;
    --accent-soft: rgba(86, 193, 255, 0.14);
    --radius: 14px;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, "SF Pro Display", Segoe UI, sans-serif;
    line-height: 1.55;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  ::selection { background: var(--accent); color: #08131c; }

  a { color: var(--text); }
  a:hover { color: var(--accent); }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .wrap {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- type scale ---------- */

  .eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin: 0;
  }
  .eyebrow-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 0.9rem;
  }
  .hero .eyebrow { margin-bottom: 0.9rem; }

  h1 {
    font-size: clamp(2.5rem, 6.2vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.04;
    margin: 0 0 1.1rem;
  }

  h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }

  p { margin: 0 0 1rem; }
  .lede { font-size: clamp(1.05rem, 1.8vw, 1.25rem); color: var(--muted); }

  /* ---------- the marks ---------- */

  svg.andeye-eye { display: block; }
  .hero-eye {
    width: clamp(230px, 36vw, 330px);
    height: auto;
    aspect-ratio: 365 / 235;
  }
  .mark-sm {
    width: 32px;
    height: auto;
    aspect-ratio: 365 / 235;
    flex: none;
  }

  /* ---------- hero ---------- */

  .hero {
    position: relative;
    padding: clamp(56px, 9vh, 96px) 0 clamp(24px, 4vh, 48px);
    text-align: center;
  }

  .hero::before {
    /* one cool lamp behind the eye: the same dusk the Time page lives in,
       lit in the brand blue */
    content: "";
    position: absolute;
    top: -140px;
    left: 50%;
    transform: translateX(-50%);
    width: min(820px, 120vw);
    height: 620px;
    background: radial-gradient(closest-side, rgba(86, 193, 255, 0.09), rgba(86, 193, 255, 0) 72%);
    pointer-events: none;
  }

  .eyewrap {
    position: relative;
    display: flex;
    justify-content: center;
    margin: 0 auto 2.2rem;
  }

  .hero .sub {
    max-width: 660px;
    margin: 0 auto;
  }

  /* ---------- load choreography ---------- */

  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--d, 0s);
  }
  .reveal.in { opacity: 1; transform: none; }

  /* ---------- sections ---------- */

  section { padding: clamp(64px, 11vh, 120px) 0; }

  /* ---------- products ---------- */

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 2.4rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--panel);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    padding: 30px 28px 26px;
    /* colour-only hover: the border and type warm to the product's own
       accent; nothing moves */
    transition: border-color 0.25s ease;
  }
  .card:hover { border-color: var(--card-accent); }
  .card-eye {
    height: 118px;
    display: flex;
    justify-content: center;
    margin-bottom: 22px;
  }
  .card-eye svg { height: 100%; width: auto; aspect-ratio: 365 / 235; }
  .card h3 {
    font-size: 1.35rem;
    letter-spacing: -0.015em;
    margin-bottom: 0.4rem;
    transition: color 0.25s ease;
  }
  .card:hover h3 { color: var(--card-accent); }
  .card p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 1.2rem;
    flex: 1;
  }
  .card-go {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--faint);
    transition: color 0.25s ease;
  }
  .card:hover .card-go { color: var(--card-accent); }

  /* ---------- values: the page's heart, so it goes darker ---------- */

  .values {
    background: var(--bg-deep);
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }
  .values .wrap { max-width: 860px; }
  .values h2 { font-size: clamp(2.1rem, 4.6vw, 3.4rem); }
  .prose { max-width: 680px; }
  .prose p { margin: 0; }
  .prose strong { color: var(--text); }
  .vlist { margin-top: 2.6rem; border-top: 1px solid var(--line-soft); }
  .vitem { border-bottom: 1px solid var(--line-soft); padding: 1.3rem 0 1.4rem; }
  .vitem h3 {
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    font-weight: 800;
    letter-spacing: -0.015em;
    margin: 0 0 0.35rem;
  }
  .vitem p { color: var(--muted); max-width: 640px; margin: 0; }

  /* ---------- footer ---------- */

  footer {
    border-top: 1px solid var(--line-soft);
    padding: 40px 0 56px;
    color: var(--faint);
    font-size: 0.88rem;
  }
  footer .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  footer nav { display: flex; gap: 22px; }
  footer a { color: var(--muted); text-decoration: none; }
  footer a:hover { color: var(--accent); }

  /* ---------- responsive ---------- */

  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; }
    .card-eye { height: 96px; }
  }
  @media (max-width: 560px) {
    /* let the headline wrap naturally on narrow screens - the desktop
       two-line break strands a one-word last line here */
    h1 br { display: none; }
  }

  /* ---------- reduced motion: final states, no choreography ---------- */

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
    }
    .reveal { opacity: 1; transform: none; }
  }
</style>
</head>
<body>

<header class="hero" id="top">
  <div class="wrap">
    <div class="eyewrap" role="img" aria-label="The andeye mark: a single-stroke ampersand that closes into a winking eye">
      <AndeyeEye variant="main" class="hero-eye" />
    </div>
    <p class="eyebrow reveal" style="--d:0s">{fm.hero.eyebrow}</p>
    {/* the space after the <br> is deliberate: line-leading whitespace
        collapses on desktop, but keeps the word gap when the narrow-screen
        media query hides the break */}
    <h1 class="reveal" style="--d:0.08s">{fm.hero.h1[0]}<br>{' '}{fm.hero.h1[1]}</h1>
    <p class="sub lede reveal" style="--d:0.16s">{fm.hero.lede}</p>
  </div>
</header>

<section id="products">
  <div class="wrap">
    <div class="eyebrow-row reveal" style="--d:0s">
      <AndeyeEye variant="main" class="mark-sm" />
      <p class="eyebrow">{fm.products.eyebrow}</p>
    </div>
    <h2 class="reveal" style="--d:0.06s">{fm.products.h2}</h2>
    <div class="cards">
      {fm.products.items.map((p, i) => (
        <a
          class="card reveal"
          style={`--d:${(0.12 + i * 0.08).toFixed(2)}s; --card-accent:${PRODUCT_ACCENT[p.eye] ?? '#56C1FF'}`}
          href={p.href}
        >
          <div class="card-eye"><AndeyeEye variant={p.eye} weight="fill" /></div>
          <h3>{p.name}</h3>
          <p>{p.blurb}</p>
          <span class="card-go">{p.link_label} &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="values" id="values">
  <div class="wrap">
    <div class="eyebrow-row reveal" style="--d:0s">
      <AndeyeEye variant="main" class="mark-sm" />
      <p class="eyebrow">{fm.values.eyebrow}</p>
    </div>
    <h2 class="reveal" style="--d:0.06s">{fm.values.h2}</h2>
    <div class="prose lede reveal" style="--d:0.12s"><Content /></div>
    <div class="vlist">
      {fm.values.items.map((v, i) => (
        <div class="vitem reveal" style={`--d:${(0.06 + i * 0.05).toFixed(2)}s`}>
          <h3>{v.heading}</h3>
          <p>{v.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <span>{fm.footer.company_line}</span>
    <nav>
      {fm.products.items.map((p) => <a href={p.href}>{p.name}</a>)}
      <a href={fm.footer.github_href}>{fm.footer.github_label}</a>
    </nav>
  </div>
</footer>

<script is:inline>
// Failsafe, deliberately separate from the choreography script below: if
// that script ever dies, the .reveal choreography never runs and the page
// would stay invisible. This tiny independent watchdog reveals everything
// on any uncaught error, and again shortly after load as a catch-all.
// Adding "in" to an already-revealed element is a no-op, so it never
// fights the normal choreography.
(function () {
  function show() {
    var els = document.querySelectorAll('.reveal:not(.in)');
    for (var i = 0; i < els.length; i++) els[i].classList.add('in');
  }
  window.addEventListener('error', function () { setTimeout(show, 0); });
  window.addEventListener('load', function () { setTimeout(show, 2500); });
})();
</script>
<script is:inline>
// Load choreography. The hero eye hand-draws itself on (the engine's
// draw-on runs ~1.2s from mount); the hero text starts landing at 0.65s so
// the two finish together. Everything below the fold reveals as it scrolls
// into view, staggered by each element's --d delay.
(function () {
  'use strict';
  var reduced = window.matchMedia
    && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function revealAll() {
    document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
  }
  if (reduced || !('IntersectionObserver' in window)) { revealAll(); return; }
  setTimeout(function () {
    document.querySelectorAll('.hero .reveal').forEach(function (el) { el.classList.add('in'); });
  }, 650);
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('in');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
  // Observation starts on the same beat as the hero text, so on a tall
  // viewport nothing below lands before the headline does.
  setTimeout(function () {
    document.querySelectorAll('section .reveal').forEach(function (el) { io.observe(el); });
  }, 650);
})();
</script>
</body>
</html>
