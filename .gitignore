# >>> vibe-managed runtime exclusions (auto-added; do not edit body) >>>
# Files vibe writes to /workspace at runtime. Committing them
# leaks per-machine state into the repo (PR-review-noise risk).
# Opt out: set VIBE_AUTO_GITIGNORE=0 before container start, or
# delete this entire block (won't be re-added once removed).
.claude/settings.local.json
# <<< vibe-managed <<<

# local-only
.DS_Store

# SwiftPM build products
.build/
*.app/

# Pro-tier staging area — NEVER committed here. Xero/paid-backend code lives
# in the private andeyePro/Pro repo; this folder only stages it until that
# repo exists on this machine.
/pro/

# site/ – Astro + Starlight product site, built by Cloudflare Pages
site/node_modules/
site/dist/
site/.astro/

# /vs harness state
.vs/cycle-*/
__pycache__/
*.pyc

# Per-machine Xcode state (public-repo hygiene)
xcuserdata/
*.xcuserstate

# The whole andeyePro repo
andeyePro/

# runtime state (sessions/ IS committed; these are per-machine)
andeyeTT
timeandeye
