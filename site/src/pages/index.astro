function fmtDur(s) {
  s = Math.max(0, Math.floor(s));
  if (s < 60) return s + 's';
  const m = Math.floor(s / 60), ss = s % 60;
  return ss ? (m + 'm ' + ss + 's') : (m + 'm');
}
function fmtTotal(s) {
  s = Math.max(0, Math.floor(s));
  return Math.floor(s / 60) + ':' + ('0' + (s % 60)).slice(-2);
}

function firstInteraction() {
  if (started) return;
