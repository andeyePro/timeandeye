// --- the demo anchors to the visitor's own day, not a fixed "Tuesday 9:41":
// server-rendered fallbacks sit in the HTML for no-JS/first paint, then this
// overwrites them once at load (plus a per-minute refresh for the menu-bar
// clock, below). Tabular numerals on every swapped span keep this reflow-free. ---
const demoHeading = document.getElementById('demoHeading');
const mbSys = document.getElementById('mbSys');
const tlClock = document.getElementById('tlClock');
const tlStart = document.getElementById('tlStart');
const mtimeSarah = document.getElementById('mtimeSarah');
const mtimePriya = document.getElementById('mtimePriya');
const mtimeAnthropic = document.getElementById('mtimeAnthropic');

function fmtClockStr(d) { return d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' }); }
// one formatter, two targets: the menu-bar system clock and the timeline
// box's live clock both read "short weekday + time", refreshed together
// whenever the minute changes (see the setInterval guard, below).
function renderMbSys(d) {
  const s = d.toLocaleDateString(undefined, { weekday: 'short' }) + ' ' + fmtClockStr(d);
  mbSys.textContent = s;
  tlClock.textContent = s;
}

const loadNow = new Date();
demoHeading.textContent = "It's " + loadNow.toLocaleDateString(undefined, { weekday: 'long' }) + ', ' + fmtClockStr(loadNow);
tlStart.textContent = fmtClockStr(loadNow);
mtimeSarah.textContent = fmtClockStr(new Date(loadNow.getTime() - 29 * 60000));
mtimePriya.textContent = fmtClockStr(new Date(loadNow.getTime() - 54 * 60000));
mtimeAnthropic.textContent = fmtClockStr(new Date(loadNow.getTime() - 86 * 60000));
renderMbSys(loadNow);
let mbSysMinute = loadNow.getMinutes();

let currentProj = null;      // the running task's project (null before first click)
let currentMailId = 'mail-sarah';
let currentTabId = 'tab-research';
let taskStart = 0;
let doneSeconds = 0;
let curBlock = null;
const projSeconds = {};
PROJ_ORDER.forEach(function (p) { projSeconds[p] = 0; });

const blocks = [];           // timeline block buttons, each carries _task/_proj/_secs
let hoveredBlock = null;
let hoveredProj = null;
let pieWedges = [];
let started = false;

function fmtDur(s) {
  s = Math.max(0, Math.floor(s));
  if (s < 60) return s + 's';
  const m = Math.floor(s / 60), ss = s % 60;
  return ss ? (m + 'm ' + ss + 's') : (m + 'm');
}
function fmtTotal(s) {
  s = Math.max(0, Math.floor(s));
  return Math.floor(s / 60) + ':' + ('0' + (s % 60)).slice(-2);
}

function firstInteraction() {
  if (started) return;
  started = true;
  desktop.classList.remove('idle');
  mbTracker.classList.remove('idle');
  driveState.textContent = "andeye is following you – keep clicking around";
  driveState.classList.add('driving');
  const e = tlStrip.querySelector('.tl-empty');
  if (e) e.remove();
}

// Show one email's reading view beside the Mail window's inbox: the same
// three rows stay put and narrow into the left third, and the reading pane
// opens in the right two thirds. No back button - clicking outside a row
// or the reading pane returns to the full-width inbox (wired on the window
// itself, below).
function showMailReading(id) {
  const e = EMAILS[id];
  if (!e) return;
  const html = '<div class="read-head"><span class="avatar" style="background:' + e.avatar + '">' + e.initials + '</span>'
    + '<span class="rh-text"><span class="rh-from">' + e.from + '</span>'
    + (e.from !== e.addr ? ('<span class="rh-addr">' + e.addr + '</span>') : '')
    + '</span></div>'
    + '<div class="read-subj">' + e.subj + '</div>'
    + '<div class="read-body">' + e.body.map(function (p) { return '<p>' + p + '</p>'; }).join('') + '</div>';
  mailRead.innerHTML = html;
  mailBody.classList.add('reading');
  mailRead.hidden = false;
}

// Reflect the focus: raise its window (macOS traffic lights + full opacity),
// mark the active row/tab, swap the browser body / open the email.
function setFocus(id) {
  const f = FOCUS[id];
  mbApp.textContent = f.app;
  Object.keys(WINS).forEach(function (k) { WINS[k].classList.toggle('focused', k === f.win); });
  surfaces.forEach(function (el) { el.classList.toggle('active', el.getAttribute('data-focus') === id); });
  if (f.win === 'winWeb') { webUrl.textContent = f.url || ''; webBody.innerHTML = WEB_ART[id] || ''; currentTabId = id; }
  if (f.win === 'winMail') { showMailReading(id); currentMailId = id; }
}

// Commit a task change: bank the last stretch, reset the clock, wink the
// menu-bar mark, and start a new timeline block coloured by project.
function commit(f) {
  const now = performance.now();
  if (currentProj !== null) {
    const dt = (now - taskStart) / 1000;
    doneSeconds += dt;
    projSeconds[currentProj] += dt;
    if (curBlock) curBlock._secs = dt;
  }
  currentProj = f.proj;
  taskStart = now;
  mbTask.textContent = f.task;
  mbClock.textContent = '0s';
  mbWinkPlay();
  curBlock = document.createElement('button');
  curBlock.type = 'button';
  curBlock.className = 'tl-block';
  curBlock.style.background = cssRGB(PROJECTS[f.proj].rgb);
  curBlock.style.flexGrow = 1;
  curBlock._task = f.task;
  curBlock._proj = f.proj;
  curBlock._secs = 0;
  curBlock.setAttribute('aria-label', f.task + ' block on the timeline');
  tlStrip.appendChild(curBlock);
  blocks.push(curBlock);
  drawPie();
}

// A click anywhere: focus the surface, tint to its certainty, and – only if
// the task actually changed – commit a new stretch.
function switchTo(id) {
  const f = FOCUS[id];
  if (!f) return;
  firstInteraction();
  setFocus(id);
  tintMB(certRGB(f.cert), reduced);
  if (f.proj !== currentProj) commit(f);
}

// Wire the surfaces (rows + tabs) and the whole-window clicks.
surfaces.forEach(function (el) {
  el.addEventListener('click', function (e) {
    e.stopPropagation();
    switchTo(el.getAttribute('data-focus'));
  });
});
// A window click that lands on a row/preview/pane already stopped its own
// propagation above; anything else in the Mail window re-affirms attribution
// and, unless it landed inside the reading pane's text, drops back to the list.
WINS.winMail.addEventListener('click', function (e) {
  switchTo(currentMailId);
  if (!mailRead.hidden && !e.target.closest('.mail-read')) {
    mailRead.hidden = true;
    mailBody.classList.remove('reading');
  }
});
WINS.winWeb.addEventListener('click', function () { switchTo(currentTabId); });

// The clock ticks; the current block grows; the pie breathes; the menu-bar
// system clock refreshes once a minute, same as a real Mac.
setInterval(function () {
  const nowD = new Date();
  if (nowD.getMinutes() !== mbSysMinute) { mbSysMinute = nowD.getMinutes(); renderMbSys(nowD); }
  if (currentProj === null) return;
  const s = (performance.now() - taskStart) / 1000;
  mbClock.textContent = fmtDur(s);
  if (curBlock) { curBlock.style.flexGrow = Math.max(s, 1); curBlock._secs = s; }
  tlTotal.textContent = fmtTotal(doneSeconds + s);
  drawPie();
  if (hoveredBlock === curBlock) tlReadout.innerHTML = '<b>' + curBlock._task + '</b> · ' + fmtDur(s);
  if (hoveredProj) updatePieReadout();
}, 250);

// --- interactive timeline: hover / click a slice to read it ---

function highlightBlock(b) {
  blocks.forEach(function (x) { x.classList.toggle('hi', x === b); });
  hoveredBlock = b || null;
  if (b) {
    const s = (b === curBlock) ? (performance.now() - taskStart) / 1000 : b._secs;
    tlReadout.innerHTML = '<b>' + b._task + '</b> · ' + fmtDur(s);
  } else {
    tlReadout.textContent = 'Hover a slice to see the task and time.';
  }
}
tlStrip.addEventListener('mouseover', function (e) {
  const b = e.target.closest('.tl-block'); if (b) highlightBlock(b);
});
tlStrip.addEventListener('mouseleave', function () { highlightBlock(null); });
tlStrip.addEventListener('click', function (e) {
  const b = e.target.closest('.tl-block'); if (b) highlightBlock(b);
});

// --- the pie: a clickable donut of time by project (matches the app's donut) ---

function liveProjSeconds() {
  const out = {};
  PROJ_ORDER.forEach(function (p) { out[p] = projSeconds[p]; });
  if (currentProj !== null) {
    out[currentProj] += (performance.now() - taskStart) / 1000;
  }
  return out;
}

const PIE_SIDE = 112; // matches the pieCanvas width/height attrs on its own always-visible box

function drawPie() {
  const secs = liveProjSeconds();
  const total = PROJ_ORDER.reduce(function (a, p) { return a + secs[p]; }, 0);
  const side = PIE_SIDE;
  sizeCanvas(pieCanvas, pieCtx, side, side);
  pieCtx.clearRect(0, 0, side, side);
  const cx = side / 2, cy = side / 2;
  const rOuter = side * 0.46;
  const rInner = side * 0.24;
  pieWedges = [];
  let a0 = -Math.PI / 2;
  if (total > 0) {
    PROJ_ORDER.forEach(function (p) {
      const w = secs[p];
      if (w <= 0) return;
      const a1 = a0 + (w / total) * Math.PI * 2;
      const hi = p === hoveredProj;
      const rO = hi ? rOuter + 4 : rOuter;
      pieCtx.beginPath();
      pieCtx.arc(cx, cy, rO, a0, a1, false);
      pieCtx.arc(cx, cy, rInner, a1, a0, true);
      pieCtx.closePath();
      const rgb = PROJECTS[p].rgb;
      pieCtx.fillStyle = hi ? cssRGB(mixRGB(rgb, [255, 255, 255], 0.18)) : cssRGB(rgb);
      pieCtx.fill();
      pieWedges.push({ proj: p, a0: a0, a1: a1 });
      a0 = a1;
    });
  } else {
    pieCtx.beginPath();
    pieCtx.arc(cx, cy, rOuter, 0, Math.PI * 2);
    pieCtx.arc(cx, cy, rInner, 0, Math.PI * 2, true);
    pieCtx.fillStyle = 'rgba(255,255,255,0.05)';
    pieCtx.fill();
  }
  pieCtx.fillStyle = '#98a0b3';
  pieCtx.font = '700 13px -apple-system, sans-serif';
  pieCtx.textAlign = 'center';
  pieCtx.textBaseline = 'middle';
  pieCtx.fillText(fmtTotal(total), cx, cy);
  drawLegend(secs, total);
}

function drawLegend(secs) {
  let html = '';
  let billable = 0;
  PROJ_ORDER.forEach(function (p) {
    const proj = PROJECTS[p];
    if (proj.billable) billable += secs[p];
    html += '<button type="button" class="legend-row' + (p === hoveredProj ? ' hi' : '') + '" data-proj="' + p + '">'
      + '<span class="legend-sw" style="background:' + cssRGB(proj.rgb) + '"></span>'
      + '<span class="legend-name">' + proj.label
      + ' <span class="legend-note">' + proj.note + '</span>'
      + '</span><span class="legend-val">' + fmtDur(secs[p]) + '</span></button>';
  });
  html += '<div class="legend-bill"><span>Billable so far</span><b class="tnum">' + fmtDur(billable) + '</b></div>';
  legendEl.innerHTML = html;
}

function updatePieReadout() {
  if (hoveredProj) {
    const s = liveProjSeconds()[hoveredProj];
    pieReadout.innerHTML = '<b>' + PROJECTS[hoveredProj].label + '</b> · ' + fmtDur(s);
  } else {
    pieReadout.textContent = 'Hover a wedge to see the project and time.';
  }
}
function setPieHover(proj) {
  if (proj === hoveredProj) return;
  hoveredProj = proj;
  drawPie();
  updatePieReadout();
}
function angleInWedge(a, a0, a1) {
  let x = a;
  while (x < a0) x += 2 * Math.PI;
  while (x >= a0 + 2 * Math.PI) x -= 2 * Math.PI;
  return x >= a0 && x < a1;
}
function pieHitTest(e) {
  const r = pieCanvas.getBoundingClientRect();
  const x = (e.clientX - r.left) / r.width * PIE_SIDE;
  const y = (e.clientY - r.top) / r.height * PIE_SIDE;
  const half = PIE_SIDE / 2;
  const dx = x - half, dy = y - half, dist = Math.hypot(dx, dy);
  if (dist < PIE_SIDE * 0.24 || dist > PIE_SIDE * 0.46 + 4) return null;
  const a = Math.atan2(dy, dx);
  for (let i = 0; i < pieWedges.length; i++) {
    if (angleInWedge(a, pieWedges[i].a0, pieWedges[i].a1)) return pieWedges[i].proj;
  }
  return null;
}
pieCanvas.addEventListener('mousemove', function (e) { setPieHover(pieHitTest(e)); });
pieCanvas.addEventListener('mouseleave', function () { setPieHover(null); });
pieCanvas.addEventListener('click', function (e) { setPieHover(pieHitTest(e)); });
legendEl.addEventListener('mouseover', function (e) {
  const row = e.target.closest('[data-proj]'); if (row) setPieHover(row.getAttribute('data-proj'));
});
legendEl.addEventListener('mouseleave', function () { setPieHover(null); });
legendEl.addEventListener('click', function (e) {
  const row = e.target.closest('[data-proj]'); if (row) setPieHover(row.getAttribute('data-proj'));
});

// --- CTA hover: subtext reacts, and the hero winks back on the waitlist ---

const ctaSub = document.getElementById('ctaSub');
const ctaStar = document.getElementById('ctaStar');
const ctaWaitlist = document.getElementById('ctaWaitlist');
const SUB_DEFAULT = 'Free and open source today. A ready-to-download app is on the way.';
const SUB_TECH = "It's free and open source. Clone the repo and build it on your Mac today – every last line of it.";
const SUB_APP = "Not a coder? No problem. Join the list and we'll email you the moment andeye is a normal app you just download and open – nothing to build, nothing to set up.";

function setSub(text, cls) {
  ctaSub.textContent = text;
  ctaSub.classList.remove('tech', 'app');
  if (cls) ctaSub.classList.add(cls);
}
function bindSub(el, text, cls) {
  el.addEventListener('mouseenter', function () { setSub(text, cls); });
  el.addEventListener('focus', function () { setSub(text, cls); });
  el.addEventListener('mouseleave', function () { setSub(SUB_DEFAULT, null); });
  el.addEventListener('blur', function () { setSub(SUB_DEFAULT, null); });
}
bindSub(ctaStar, SUB_TECH, 'tech');
bindSub(ctaWaitlist, SUB_APP, 'app');

let lastCtaWink = 0;
ctaWaitlist.addEventListener('mouseenter', function () {
  const now = performance.now();
  if (reduced || heroTimer !== null || now - lastCtaWink < 2500) return;
  lastCtaWink = now;
  heroWinkPlay();
});

// --- the flowsheet: observe -> attribute -> post, hover previews, click pins ---

const FLOW = {
  observe: {
    text: 'andeye watches your active window, tab and app as you work – and who a piece of mail is from. No screenshots, no keystrokes. It all stays on your Mac.',
    slug: 'auto-tracking-and-attribution',
  },
  attribute: {
    text: 'Each minute lands on a task with a certainty score. 94% sure that thread was the Coleman retainer; not at all sure the newsletter was work – and it says so. A kitten break is a break. It never rounds up.',
    slug: 'auto-tracking-and-attribution',
  },
  post: {
    text: 'The hours you approve post to your own tools – OpenProject today, Xero (and others) via Pro later. You keep the final say on every entry, and it only goes where you already keep your work.',
    slug: 'data-sync-and-safety',
  },
};
const FLOW_DEFAULT = 'It reads the room, so every minute finds its task, and completes your timesheets for you.';
const flowDetail = document.getElementById('flowDetail');
const flowNodes = Array.prototype.slice.call(document.querySelectorAll('.flow-node'));
let flowPinned = null;

function renderFlowDetail(key) {
  if (!key) { flowDetail.innerHTML = '<p>' + FLOW_DEFAULT + '</p>'; return; }
  const f = FLOW[key];
  flowDetail.innerHTML = '<p>' + f.text
    + (f.slug ? ' <a href="/manual/' + f.slug + '/" target="_blank" rel="noopener">more in the manual &rarr;</a>' : '')
    + '</p>';
}
flowNodes.forEach(function (btn) {
  const key = btn.getAttribute('data-flow');
  btn.addEventListener('mouseenter', function () { renderFlowDetail(key); });
  btn.addEventListener('focus', function () { renderFlowDetail(key); });
  btn.addEventListener('mouseleave', function () { renderFlowDetail(flowPinned); });
  btn.addEventListener('blur', function () { renderFlowDetail(flowPinned); });
  btn.addEventListener('click', function () {
    if (flowPinned === key) {
      flowPinned = null;
    } else {
      if (flowPinned) {
        const prev = document.querySelector('.flow-node[data-flow="' + flowPinned + '"]');
        if (prev) { prev.classList.remove('pinned'); prev.setAttribute('aria-pressed', 'false'); }
      }
      flowPinned = key;
    }
    btn.classList.toggle('pinned', flowPinned === key);
    btn.setAttribute('aria-pressed', String(flowPinned === key));
    renderFlowDetail(flowPinned);
  });
});
renderFlowDetail(null);

// --- privacy accordions: click the headline row to reveal the dig-in layer ---

Array.prototype.slice.call(document.querySelectorAll('.acc-item')).forEach(function (item) {
  const head = item.querySelector('.acc-head');
  head.addEventListener('click', function () {
    const open = item.classList.toggle('open');
    head.setAttribute('aria-expanded', String(open));
  });
});

// --- Community & Pro tabs: hover previews, click pins (same paradigm as the flow) ---

const CTAB_CONTENT = {
  tracker: '<p>The macOS app is open source under AGPL-3.0. Clone the repo and build it today – observation, attribution, certainty scores and the OpenProject connector, all included.</p>'
    + '<a href="https://github.com/andeyePro/andeyeTT">Star on GitHub &rarr;</a>',
  pro: '<p>andeyePro adds the paid extras: Xero (and others), plus an iPhone companion. The tracker itself stays free, local and yours.</p>'
    + '<a href="mailto:time@andeye.com?subject=andeye%20time%20tracker%20waitlist">Join the waitlist &rarr;</a>',
};
const ctabButtons = Array.prototype.slice.call(document.querySelectorAll('.ctab'));
const ctabUnderline = document.getElementById('ctabUnderline');
const cpanel = document.getElementById('cpanel');
let ctabPinned = 'tracker';

function paintCtab(key) {
  const btn = document.querySelector('.ctab[data-tab="' + key + '"]');
  if (btn) { ctabUnderline.style.left = btn.offsetLeft + 'px'; ctabUnderline.style.width = btn.offsetWidth + 'px'; }
  cpanel.innerHTML = CTAB_CONTENT[key];
}
ctabButtons.forEach(function (btn) {
  const key = btn.getAttribute('data-tab');
  btn.addEventListener('mouseenter', function () { paintCtab(key); });
  btn.addEventListener('focus', function () { paintCtab(key); });
  btn.addEventListener('mouseleave', function () { paintCtab(ctabPinned); });
  btn.addEventListener('blur', function () { paintCtab(ctabPinned); });
  btn.addEventListener('click', function () {
    ctabPinned = key;
    ctabButtons.forEach(function (b) {
      b.classList.toggle('pinned', b === btn);
      b.setAttribute('aria-selected', String(b === btn));
    });
    paintCtab(ctabPinned);
  });
});
paintCtab(ctabPinned);

// --- load: the hero eye draws itself on and says hello; the demo waits ---
// There is NO autoplay. The desktop breathes a "try me" hint until the first
// click, then the visitor drives. Reduced motion: everything simply there,
// hero fully drawn, demo idle and waiting.

function revealAll() {
  document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
}

sizeAll();
['eyebrowHow', 'eyebrowPrivacy', 'eyebrowCommunity'].forEach(makeEyebrowMark);
webBody.innerHTML = WEB_ART[currentTabId];
drawPie();
desktop.classList.add('idle');
window.addEventListener('resize', function () {
  sizeAll();
  drawPie();
  paintCtab();
});

if (reduced) {
  heroT = 1; renderHero();
  revealAll();
} else {
  heroDrawOn(function () {
    setTimeout(function () { heroWinkPlay(); }, 180);
    setTimeout(revealAll, 620);
    setTimeout(scheduleHeroBlink, 1500);
  });
}

})();
</script>
