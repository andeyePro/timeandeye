---
// andeye landing page - the "Watchful" treatment, productionised from
// the design bake-off. The hero demo geometry is a verbatim port of
// Sources/andeyeTTCore/AndeyeLogo.swift (svgCubics, translate,
// strokeWidth, the eyelid-close wink control points); keep them in sync.
// The HERO mark is always the orange accent (it's andeye saying hello).
// Only the small MENU-BAR mark carries the certainty tint, verbatim from
// MenuTitle.colour: #FF3B30 (systemRed) when unsure -> #34C759 (systemGreen)
// when sure, blended linearly by certainty. RED = unsure, GREEN = sure.
// There is no autoplay: the demo sits idle until the visitor clicks.
// Timeline slices and pie wedges are coloured by project via the app's
// HSB hash palette (AppController.colour) and are clickable/hoverable.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>andeye - automatic time tracking for your Mac</title>
<meta name="description" content="andeye tracks your time automatically, on your Mac. It watches what you are working on and attributes each minute to the right task with an honest certainty score. The watching stays on your machine; only the finished hours you approve are sent, to your own tools." />
<link rel="canonical" href="https://andeye.com/" />
<style>
  :root {
    --bg: #0c0f16;
    --bg-deep: #090b11;
    --panel: #131826;
    --panel-2: #161c2c;
    --line: #232b40;
    --line-soft: #1b2233;
    --text: #eef1f6;
    --muted: #98a0b3;
    --faint: #6a7382;
    --accent: #f0a13a;
    --accent-soft: rgba(240, 161, 58, 0.14);
    --radius: 14px;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, "SF Pro Display", Segoe UI, sans-serif;
    line-height: 1.55;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  ::selection { background: var(--accent); color: #14100a; }

  a { color: var(--text); }
  a:hover { color: var(--accent); }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .tnum { font-variant-numeric: tabular-nums; }

  .wrap {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- type scale ---------- */

  .eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.9rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6.2vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.04;
    margin: 0 0 1.1rem;
  }

  h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }

  p { margin: 0 0 1rem; }
  .lede { font-size: clamp(1.05rem, 1.8vw, 1.25rem); color: var(--muted); }

  /* ---------- hero ---------- */

  .hero {
    position: relative;
    padding: clamp(56px, 9vh, 96px) 0 40px;
    text-align: center;
  }

  .hero::before {
    /* one warm lamp behind the eye: the dusk this page lives in */
    content: "";
    position: absolute;
    top: -140px;
    left: 50%;
    transform: translateX(-50%);
    width: min(820px, 120vw);
    height: 620px;
    background: radial-gradient(closest-side, rgba(240, 161, 58, 0.09), rgba(240, 161, 58, 0) 72%);
    pointer-events: none;
  }

  .eyewrap {
    position: relative;
    display: flex;
    justify-content: center;
    margin: 0 auto 2.2rem;
  }
  #heroEye { display: block; max-width: 100%; height: auto; }

  .hero .sub {
    max-width: 660px;
    margin: 0 auto 1.9rem;
  }

  .ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 0.7rem;
  }

  .btn {
    display: inline-block;
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.005em;
    text-decoration: none;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }
  .btn-primary {
    background: var(--accent);
    color: #171006;
  }
  .btn-primary:hover { background: #ffb44f; color: #171006; transform: translateY(-1px); }
  .btn-ghost {
    background: transparent;
    color: var(--text);
    border-color: var(--line);
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-1px); }

  /* hover-reactive CTA subtext: one line that answers whichever button you're on */
  .cta-sub {
    min-height: 1.4em;
    margin: 0 auto 0.7rem;
    max-width: 560px;
    font-size: 0.92rem;
    color: var(--muted);
    transition: color 0.25s ease, opacity 0.25s ease;
  }
  .cta-sub.tech { color: #b7c0d4; }
  .cta-sub.app { color: #f4c98a; }

  .fineprint {
    font-size: 0.85rem;
    color: var(--faint);
    margin: 0;
  }

  /* ---------- load choreography ---------- */

  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--d, 0s);
  }
  .reveal.in { opacity: 1; transform: none; }

  /* ---------- demo ---------- */

  .demo {
    max-width: 900px;
    margin: clamp(40px, 7vh, 72px) auto 0;
    text-align: left;
  }

  .demo-head { text-align: center; margin-bottom: 1.4rem; }
  .demo-head h2 { margin-bottom: 0.5rem; }
  .demo-head p { color: var(--muted); max-width: 620px; margin: 0 auto; }

  .demo-note {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
  }
  #driveState {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--faint);
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    padding: 4px 14px;
    transition: color 0.4s, border-color 0.4s;
  }
  #driveState.driving { color: var(--accent); border-color: rgba(240, 161, 58, 0.4); }

  .mac {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--panel);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
  }

  .menubar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 7px 14px;
    background: rgba(21, 26, 39, 0.96);
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.8rem;
    min-height: 34px;
  }
  .mb-app { font-weight: 800; letter-spacing: -0.01em; }
  .mb-menus { color: var(--faint); letter-spacing: 0.02em; }
  .mb-spacer { flex: 1; }
  .mb-tracker {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  #mbEye { display: block; }
  #mbClock { font-weight: 700; color: var(--muted); min-width: 2.4em; text-align: right; }
  #mbTask {
    color: var(--muted);
    font-weight: 600;
    max-width: 130px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mb-tracker.idle #mbClock, .mb-tracker.idle #mbTask { color: var(--faint); }
  .mb-sys { color: var(--faint); }

  /* the desktop: three work windows on top, andeye's own Time window beneath,
     so the timeline and pie are in view from the very first frame */
  .desktop {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding: 22px;
    background: radial-gradient(120% 130% at 50% 0%, #1a2233 0%, #121722 58%, #0e1220 100%);
  }

  .win {
    display: flex;
    flex-direction: column;
    background: #141927;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    min-height: 196px;
    opacity: 0.5;
    cursor: pointer;
    transition: opacity 0.35s, box-shadow 0.35s;
  }
  .win:not(.focused):not(.win-andeye):hover { opacity: 0.78; }
  .win.focused {
    opacity: 1;
    cursor: default;
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.45);
  }
  /* andeye's own window: always legible, never a tracked surface */
  .win.win-andeye {
    grid-column: 1 / -1;
    opacity: 1;
    cursor: default;
    min-height: 0;
  }
  /* the try-me hint: work windows breathe gently until the first click */
  .desktop.idle .win:not(.win-andeye) { animation: hintpulse 2.4s ease-in-out infinite; }
  .desktop.idle .win:nth-child(2) { animation-delay: 0.3s; }
  .desktop.idle .win:nth-child(3) { animation-delay: 0.6s; }
  @keyframes hintpulse {
    0%, 100% { opacity: 0.5; box-shadow: 0 0 0 0 rgba(240, 161, 58, 0); }
    50% { opacity: 0.7; box-shadow: 0 0 0 3px rgba(240, 161, 58, 0.13); }
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 11px;
    background: #1a2131;
    border-bottom: 1px solid var(--line-soft);
  }
  /* real-macOS traffic lights: coloured when focused, hollow when not */
  .traffic { display: flex; align-items: center; gap: 7px; flex: none; }
  .traffic i {
    width: 11px; height: 11px; border-radius: 50%;
    background: transparent;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    display: block;
  }
  .win.focused .traffic .tl-c { background: #ff5f57; box-shadow: none; }
  .win.focused .traffic .tl-m { background: #febc2e; box-shadow: none; }
  .win.focused .traffic .tl-z { background: #28c840; box-shadow: none; }
  .wtitle { margin-left: 7px; font-size: 0.72rem; color: #8b93a8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* email client */
  .mail-body { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .mail-list { display: flex; flex-direction: column; }
  .mailrow {
    font: inherit;
    color: inherit;
    text-align: left;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line-soft);
    cursor: pointer;
    transition: background 0.25s;
  }
  .mailrow:last-child { border-bottom: none; }
  .mailrow:hover { background: rgba(255, 255, 255, 0.03); }
  .mailrow.active { background: rgba(240, 161, 58, 0.09); }
  .avatar {
    width: 30px; height: 30px; border-radius: 50%;
    flex: none;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.82rem; font-weight: 800; color: #10131c;
  }
  .mtext { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .mfrom { font-size: 0.82rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .msubj { font-size: 0.76rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mtime { font-size: 0.7rem; color: var(--faint); flex: none; }
  .unread .mfrom::before {
    content: ""; display: inline-block; width: 7px; height: 7px;
    border-radius: 50%; background: var(--accent); margin-right: 6px; vertical-align: middle;
  }

  /* email reading view */
  .mail-read { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 9px; flex: 1; }
  .mail-back {
    font: inherit; font-size: 0.72rem; color: var(--muted);
    background: none; border: none; padding: 0; cursor: pointer;
    align-self: flex-start;
  }
  .mail-back:hover { color: var(--accent); }
  .read-head { display: flex; align-items: center; gap: 10px; }
  .rh-text { display: flex; flex-direction: column; min-width: 0; }
  .rh-from { font-size: 0.82rem; font-weight: 700; }
  .rh-addr { font-size: 0.72rem; color: var(--faint); }
  .read-subj { font-size: 0.82rem; font-weight: 700; }
  .read-body p { font-size: 0.76rem; color: var(--muted); margin: 0 0 6px; line-height: 1.5; }

  /* browser with tabs */
  .tabbar { display: flex; align-items: center; gap: 4px; padding: 7px 9px 0; background: #1a2131; }
  .tab {
    font: inherit;
    color: #8b93a8;
    display: flex; align-items: center; gap: 6px;
    max-width: 46%;
    padding: 6px 10px;
    font-size: 0.7rem;
    background: #141a27;
    border: 1px solid var(--line-soft);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: background 0.25s, color 0.25s;
  }
  .tab .fav { width: 14px; height: 14px; flex: none; }
  .tab.active { background: #0e1220; color: var(--text); }
  .urlbar {
    margin: 8px 11px 0;
    font-size: 0.68rem;
    color: var(--faint);
    background: #10141f;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    padding: 4px 12px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .webbody {
    flex: 1;
    min-height: 130px;
    padding: 10px 12px;
    display: flex;
    background: #0e1220;
  }

  /* inline line-art canvases (browser content + proposal document) */
  .art { width: 100%; height: auto; max-height: 148px; color: #4d566e; display: block; margin: auto; }

  /* the proposal document */
  .doc-body { flex: 1; padding: 10px 12px; display: flex; background: #0e1220; }

  /* ---------- the andeye Time window: real timeline + real pie, in frame ---------- */

  .time-body {
    flex: 1;
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 22px;
    padding: 13px 16px 12px;
    background: #10141f;
  }
  .time-label {
    margin: 0 0 9px;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
    font-weight: 700;
  }

  /* timeline: coloured slices by project, a horizontal time axis */
  .tl-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--faint);
    margin-bottom: 8px;
    letter-spacing: 0.03em;
  }
  #tlTotal { color: var(--muted); font-weight: 700; }
  .tl-strip {
    display: flex;
    gap: 2px;
    height: 30px;
    border-radius: 6px;
    overflow: hidden;
    background: #0e1220;
    border: 1px solid var(--line-soft);
  }
  .tl-empty { margin: auto; font-size: 0.72rem; color: var(--faint); }
  .tl-block {
    flex-grow: 1;
    min-width: 5px;
    padding: 0;
    border: none;
    cursor: pointer;
    transition: flex-grow 0.4s linear, filter 0.2s, transform 0.2s;
  }
  .tl-block.hi { filter: brightness(1.28); transform: scaleY(1.12); }
  .tl-axis {
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    color: var(--faint);
    margin-top: 5px;
    font-variant-numeric: tabular-nums;
  }

  /* pie: donut of time by project with a legend */
  .pie-wrap { display: flex; align-items: center; gap: 16px; }
  #pieCanvas { display: block; flex: none; cursor: pointer; }
  .legend { display: flex; flex-direction: column; gap: 6px; font-size: 0.8rem; flex: 1; min-width: 0; }
  .legend-row {
    font: inherit; text-align: left;
    display: flex; align-items: center; gap: 8px;
    background: none; border: none; padding: 3px 4px; border-radius: 6px;
    cursor: pointer; width: 100%;
    transition: background 0.2s;
  }
  .legend-row.hi { background: rgba(255, 255, 255, 0.05); }
  .legend-sw { width: 11px; height: 11px; border-radius: 3px; flex: none; }
  .legend-name { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--muted); }
  .legend-val { color: var(--faint); font-variant-numeric: tabular-nums; }
  .legend-note { font-size: 0.68rem; color: var(--faint); font-style: italic; }
  .legend-bill {
    margin-top: 7px;
    padding: 6px 4px 0;
    border-top: 1px solid var(--line-soft);
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .legend-bill b { color: var(--text); font-weight: 700; }

  .readout {
    margin-top: 10px;
    font-size: 0.74rem;
    color: var(--faint);
    min-height: 1.15em;
  }
  .readout b { color: var(--muted); font-weight: 700; }

  .demo-caption {
    margin: 14px 0 0;
    font-size: 0.8rem;
    color: var(--faint);
    text-align: center;
  }

  /* ---------- sections ---------- */

  section { padding: clamp(64px, 11vh, 120px) 0; }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 2.4rem;
  }
  .step {
    background: var(--panel);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    padding: 26px 24px 22px;
  }
  .step .num {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--accent);
    display: block;
    margin-bottom: 1rem;
  }
  .step p { color: var(--muted); font-size: 0.96rem; margin: 0; }

  /* privacy: the treatment's heart, so it goes darker and bigger */
  .privacy {
    background: var(--bg-deep);
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }
  .privacy .wrap { max-width: 860px; }
  .privacy h2 { font-size: clamp(2.1rem, 4.6vw, 3.4rem); }
  #pvEye { display: block; margin-bottom: 1.6rem; }
  .pv-claims {
    display: grid;
    gap: 2rem;
    margin-top: 2.8rem;
  }
  .pv-claims h3 {
    font-size: clamp(1.35rem, 2.6vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.015em;
  }
  .pv-claims p { color: var(--muted); max-width: 620px; margin: 0; }

  .tiers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 2.4rem;
  }
  .tier {
    background: var(--panel);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
  }
  .tier.pro { border-color: rgba(240, 161, 58, 0.3); }
  .tier .tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 0.9rem;
  }
  .tier.pro .tag { color: var(--accent); }
  .tier p { color: var(--muted); font-size: 0.97rem; flex: 1; }
  .tier a { font-weight: 700; text-decoration: none; color: var(--accent); }
  .tier a:hover { text-decoration: underline; }

  /* ---------- footer ---------- */

  footer {
    border-top: 1px solid var(--line-soft);
    padding: 40px 0 56px;
    color: var(--faint);
    font-size: 0.88rem;
  }
  footer .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  footer nav { display: flex; gap: 22px; }
  footer a { color: var(--muted); text-decoration: none; }
  footer a:hover { color: var(--accent); }

  /* ---------- responsive ---------- */

  @media (max-width: 820px) {
    .steps { grid-template-columns: 1fr; }
    .tiers { grid-template-columns: 1fr; }
    .mb-menus { display: none; }
    .desktop { grid-template-columns: 1fr 1fr; }
    .win-doc { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .desktop { grid-template-columns: 1fr; padding: 14px; gap: 14px; }
    .time-body { grid-template-columns: 1fr; }
    #mbTask { max-width: 90px; }
    .mb-sys { display: none; }
    .tab { max-width: 40%; }
  }

  /* ---------- reduced motion: final states, no choreography ---------- */

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
    }
    .reveal { opacity: 1; transform: none; }
  }
</style>
</head>
<body>

<header class="hero" id="top">
  <div class="wrap">
    <div class="eyewrap">
      <canvas id="heroEye" role="img" aria-label="The andeye mark: a single-stroke ampersand that closes into an eye"></canvas>
    </div>
    <p class="eyebrow reveal" style="--d:0s">andeye &middot; automatic time tracking for macOS</p>
    <h1 class="reveal" style="--d:0.08s">andeye watches.<br>You just work.</h1>
    <p class="sub lede reveal" style="--d:0.16s">A menu-bar tracker that attributes your time to tasks by itself &ndash; on your Mac, never phoning home &ndash; with an honest certainty score on every minute.</p>
    <div class="ctas reveal" style="--d:0.26s">
      <a class="btn btn-primary" id="ctaStar" href="https://github.com/andeyePro/andeyeTT">Star on GitHub</a>
      <a class="btn btn-ghost" id="ctaWaitlist" href="mailto:hello@andeye.com?subject=andeye%20waitlist">Join the waitlist</a>
    </div>
    <p class="cta-sub reveal" id="ctaSub" style="--d:0.3s" aria-live="polite">Free and open source today. A ready-to-download app is on the way.</p>
    <p class="fineprint reveal" style="--d:0.34s">macOS 14+ &middot; free and open source &middot; build from source today</p>

    <div class="demo reveal" style="--d:0.46s" id="demo">
      <div class="demo-head">
        <h2>Your Tuesday morning, 9:41</h2>
