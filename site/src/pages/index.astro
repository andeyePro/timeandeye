---
// andeye landing page — the "Watchful" treatment, picked by Martin from
// the three-way bake-off (Instrument / Ink / Watchful), all authored by
// Fable 5 subagents. The hero demo geometry is a verbatim port of
// Sources/andeyeTTCore/AndeyeLogo.swift; keep them in sync.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>andeye — automatic time tracking for your Mac</title>
<meta name="description" content="andeye tracks your time automatically, on your Mac. It watches what you are working on and attributes each minute to the right task with an honest certainty score." />
<link rel="canonical" href="https://andeye.com/" />
<style>
  :root {
    --bg: #0c0f16;
    --bg-deep: #090b11;
    --panel: #131826;
    --panel-2: #161c2c;
    --line: #232b40;
    --line-soft: #1b2233;
    --text: #eef1f6;
    --muted: #98a0b3;
    --faint: #6a7382;
    --accent: #f0a13a;
    --accent-soft: rgba(240, 161, 58, 0.14);
    --radius: 14px;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, "SF Pro Display", Segoe UI, sans-serif;
    line-height: 1.55;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  ::selection { background: var(--accent); color: #14100a; }

  a { color: var(--text); }
  a:hover { color: var(--accent); }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .tnum { font-variant-numeric: tabular-nums; }

  .wrap {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- type scale ---------- */

  .eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.9rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6.2vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.04;
    margin: 0 0 1.1rem;
  }

  h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }

  p { margin: 0 0 1rem; }
  .lede { font-size: clamp(1.05rem, 1.8vw, 1.25rem); color: var(--muted); }

  /* ---------- hero ---------- */

  .hero {
    position: relative;
    padding: clamp(56px, 9vh, 96px) 0 40px;
    text-align: center;
  }

  .hero::before {
    /* one warm lamp behind the eye: the dusk this page lives in */
    content: "";
    position: absolute;
    top: -140px;
    left: 50%;
    transform: translateX(-50%);
    width: min(820px, 120vw);
    height: 620px;
    background: radial-gradient(closest-side, rgba(240, 161, 58, 0.09), rgba(240, 161, 58, 0) 72%);
    pointer-events: none;
  }

  .eyewrap {
    position: relative;
    display: flex;
    justify-content: center;
    margin: 0 auto 2.2rem;
  }
  #heroEye { display: block; max-width: 100%; height: auto; }

  .hero .sub {
    max-width: 640px;
    margin: 0 auto 1.9rem;
  }

  .ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  .btn {
    display: inline-block;
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.005em;
    text-decoration: none;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }
  .btn-primary {
    background: var(--accent);
    color: #171006;
  }
  .btn-primary:hover { background: #ffb44f; color: #171006; transform: translateY(-1px); }
  .btn-ghost {
    background: transparent;
    color: var(--text);
    border-color: var(--line);
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-1px); }

  .fineprint {
    font-size: 0.85rem;
    color: var(--faint);
    margin: 0;
  }

  /* ---------- load choreography ---------- */

  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--d, 0s);
  }
  .reveal.in { opacity: 1; transform: none; }

  /* ---------- demo ---------- */

  .demo {
    max-width: 880px;
    margin: clamp(40px, 7vh, 72px) auto 0;
    text-align: left;
  }

  .demo-head { text-align: center; margin-bottom: 1.4rem; }
  .demo-head h2 { margin-bottom: 0.5rem; }
  .demo-head p { color: var(--muted); max-width: 560px; margin: 0 auto; }

  .demo-note {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
  }
  #driveState {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--faint);
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    padding: 4px 14px;
    transition: color 0.4s, border-color 0.4s;
  }
  #driveState.driving { color: var(--accent); border-color: rgba(240, 161, 58, 0.4); }

  .mac {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--panel);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
  }

  .menubar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 7px 14px;
    background: rgba(21, 26, 39, 0.96);
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.8rem;
    min-height: 34px;
  }
  .mb-app { font-weight: 800; letter-spacing: -0.01em; }
  .mb-menus { color: var(--faint); letter-spacing: 0.02em; }
  .mb-spacer { flex: 1; }
  .mb-tracker {
    display: flex;
    align-items: center;
    gap: 9px;
    transition: opacity 0.3s;
  }
  .mb-tracker.attributing #mbTask,
  .mb-tracker.attributing #mbCert { opacity: 0.35; }
  #mbTask {
    color: var(--muted);
    max-width: 220px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity 0.3s;
  }
  #mbClock { font-weight: 700; }
  #mbCert { font-weight: 700; transition: color 0.4s, opacity 0.3s; color: var(--faint); }
  #mbEye { display: block; }
  .mb-sys { color: var(--faint); }

  .desktop {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: 22px;
    background: radial-gradient(120% 130% at 50% 0%, #1a2233 0%, #121722 58%, #0e1220 100%);
  }

  .app-card {
    font: inherit;
    color: inherit;
    text-align: left;
    padding: 0;
    display: flex;
    flex-direction: column;
    background: #141927;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.72;
    transition: opacity 0.35s, border-color 0.35s, box-shadow 0.35s, transform 0.35s;
  }
  .app-card:hover { opacity: 0.92; border-color: #33405c; }
  .app-card.active {
    opacity: 1;
    border-color: rgba(240, 161, 58, 0.55);
    box-shadow: 0 0 0 1px rgba(240, 161, 58, 0.22), 0 16px 44px rgba(0, 0, 0, 0.45);
    transform: translateY(-2px);
  }
  .app-card.autopulse { animation: pulse 0.55s ease; }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(240, 161, 58, 0.45); }
    100% { box-shadow: 0 0 0 14px rgba(240, 161, 58, 0); }
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 11px;
    background: #1a2131;
    border-bottom: 1px solid var(--line-soft);
  }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: #38425b; }
  .wtitle { margin-left: 7px; font-size: 0.72rem; color: #8b93a8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .app-body {
    flex: 1;
    min-height: 128px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* browser-on-webmail silhouette */
  .urlbar {
    display: block;
    font-size: 0.68rem;
    color: var(--faint);
    background: #10141f;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    padding: 3px 12px;
    width: 70%;
  }
  .mail-cols { display: flex; gap: 10px; flex: 1; }
  .rail { display: flex; flex-direction: column; gap: 7px; width: 26%; }
  .pill { display: block; height: 14px; border-radius: 999px; background: var(--accent-soft); border: 1px solid rgba(240, 161, 58, 0.4); }
  .rl { display: block; height: 6px; border-radius: 4px; background: #2a3346; }
  .rl:nth-child(3) { width: 80%; }
  .rl:nth-child(4) { width: 65%; }
  .mlist { display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .mrow { display: flex; gap: 8px; align-items: center; }
  .mrow i { display: block; height: 6px; border-radius: 4px; background: #33405c; }
  .mrow .frm { width: 26%; background: #40506f; }
  .mrow .subj { flex: 1; }
  .mrow.unread .frm, .mrow.unread .subj { background: #55617e; }

  /* code editor silhouette */
  .code-lines { display: flex; flex-direction: column; gap: 7px; }
  .cl { display: flex; gap: 10px; align-items: center; }
  .cl b { display: block; width: 14px; height: 5px; border-radius: 3px; background: #232b40; }
  .cl i { display: block; height: 6px; border-radius: 4px; background: #33405c; }
  .cl:nth-child(1) i { width: 48%; }
  .cl:nth-child(2) i { width: 72%; background: #40506f; }
  .cl:nth-child(3) i { width: 34%; margin-left: 18px; }
  .cl:nth-child(4) i { width: 58%; margin-left: 18px; background: rgba(240, 161, 58, 0.5); }
  .cl:nth-child(5) i { width: 44%; margin-left: 18px; }
  .cl:nth-child(6) i { width: 20%; }
  .cl:nth-child(7) i { width: 63%; background: #40506f; }

  /* design canvas silhouette */
  .canvas-area {
    flex: 1;
    display: flex;
    gap: 12px;
  }
  .tools { display: flex; flex-direction: column; gap: 7px; width: 18px; }
  .tools i { display: block; width: 14px; height: 14px; border-radius: 4px; background: #2a3346; }
  .tools i:first-child { background: var(--accent-soft); border: 1px solid rgba(240, 161, 58, 0.4); }
  .board {
    flex: 1;
    background: #1b2334;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
  }
  .shape { position: absolute; border: 2px solid #55617e; }
  .shape.circle { width: 44px; height: 44px; border-radius: 50%; left: 14%; top: 22%; }
  .shape.rect { width: 68px; height: 34px; border-radius: 8px; right: 12%; top: 18%; border-color: rgba(240, 161, 58, 0.65); }
  .shape.line { width: 40%; height: 0; border-width: 0 0 2px; left: 20%; bottom: 24%; }

  /* terminal silhouette */
  .term { background: #0b0f18; border-radius: 8px; flex: 1; padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
  .trow { display: flex; gap: 8px; align-items: center; font-size: 0.72rem; color: #5d6activator; }
  .trow s { text-decoration: none; color: rgba(240, 161, 58, 0.8); font-weight: 700; }
  .trow i { display: block; height: 5px; border-radius: 3px; background: #273046; }
  .trow:nth-child(1) i { width: 55%; }
  .trow:nth-child(2) i { width: 34%; background: #1d2434; }
  .trow:nth-child(3) i { width: 68%; background: #1d2434; }
  .cursor { width: 7px; height: 13px; background: #9aa3b8; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* timeline */
  .timeline { margin-top: 14px; }
  .tl-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--faint);
    margin-bottom: 7px;
    letter-spacing: 0.03em;
  }
  #tlTotal { color: var(--muted); font-weight: 700; }
  .tl-strip {
    display: flex;
    gap: 2px;
    height: 12px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--panel);
    border: 1px solid var(--line-soft);
  }
  .tl-strip:empty { opacity: 0.4; }
  .tl-block {
    flex-grow: 1;
    min-width: 3px;
    transition: flex-grow 0.4s linear;
  }
  .tl-key {
    margin-top: 8px;
    font-size: 0.74rem;
    color: var(--faint);
  }

  /* ---------- sections ---------- */

  section { padding: clamp(64px, 11vh, 120px) 0; }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 2.4rem;
  }
  .step {
    background: var(--panel);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    padding: 26px 24px 22px;
  }
  .step .num {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--accent);
    display: block;
    margin-bottom: 1rem;
  }
  .step p { color: var(--muted); font-size: 0.96rem; margin: 0; }

  /* privacy: the treatment's heart, so it goes darker and bigger */
  .privacy {
    background: var(--bg-deep);
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }
  .privacy .wrap { max-width: 860px; }
  .privacy h2 { font-size: clamp(2.1rem, 4.6vw, 3.4rem); }
  #pvEye { display: block; margin-bottom: 1.6rem; }
  .pv-claims {
    display: grid;
    gap: 2rem;
    margin-top: 2.8rem;
  }
  .pv-claims h3 {
    font-size: clamp(1.35rem, 2.6vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.015em;
  }
  .pv-claims p { color: var(--muted); max-width: 560px; margin: 0; }

  .tiers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 2.4rem;
  }
  .tier {
    background: var(--panel);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
  }
  .tier.pro { border-color: rgba(240, 161, 58, 0.3); }
  .tier .tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 0.9rem;
  }
  .tier.pro .tag { color: var(--accent); }
  .tier p { color: var(--muted); font-size: 0.97rem; flex: 1; }
  .tier a { font-weight: 700; text-decoration: none; color: var(--accent); }
  .tier a:hover { text-decoration: underline; }

  /* ---------- footer ---------- */

  footer {
    border-top: 1px solid var(--line-soft);
    padding: 40px 0 56px;
    color: var(--faint);
    font-size: 0.88rem;
  }
  footer .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  footer nav { display: flex; gap: 22px; }
  footer a { color: var(--muted); text-decoration: none; }
  footer a:hover { color: var(--accent); }

  /* ---------- responsive ---------- */

  @media (max-width: 820px) {
    .steps { grid-template-columns: 1fr; }
    .tiers { grid-template-columns: 1fr; }
    .mb-menus { display: none; }
  }
  @media (max-width: 560px) {
    .desktop { grid-template-columns: 1fr; padding: 14px; gap: 12px; }
    .app-body { min-height: 104px; }
    #mbTask { max-width: 110px; }
    .mb-sys { display: none; }
  }

  /* ---------- reduced motion: final states, no choreography ---------- */

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
    }
    .reveal { opacity: 1; transform: none; }
  }
</style>
</head>
<body>

<header class="hero" id="top">
  <div class="wrap">
    <div class="eyewrap">
      <canvas id="heroEye" role="img" aria-label="The andeye mark: a single-stroke ampersand that closes into an eye"></canvas>
    </div>
    <p class="eyebrow reveal" style="--d:0s">andeye &middot; automatic time tracking for macOS</p>
    <h1 class="reveal" style="--d:0.08s">andeye watches.<br>You just work.</h1>
    <p class="sub lede reveal" style="--d:0.16s">A menu-bar tracker that attributes your time to tasks by itself &ndash; on your Mac, never off it &ndash; with an honest certainty score on every minute.</p>
    <div class="ctas reveal" style="--d:0.26s">
      <a class="btn btn-primary" href="https://github.com/andeyePro/andeyeTT">Star on GitHub</a>
      <a class="btn btn-ghost" id="ctaWaitlist" href="mailto:hello@andeye.com?subject=andeye%20waitlist">Join the waitlist</a>
    </div>
    <p class="fineprint reveal" style="--d:0.34s">macOS 14+ &middot; free and open source &middot; build from source today</p>

    <div class="demo reveal" style="--d:0.46s" id="demo">
      <div class="demo-head">
        <h2>A day at your Mac, in miniature</h2>
        <p>Click around like you're working. The eye follows, winks when you switch, and its tint is its confidence: grey when unsure, amber when sure.</p>
      </div>
      <div class="demo-note"><span id="driveState">auto-demo &middot; click any window to take over</span></div>
      <div class="mac">
        <div class="menubar" aria-live="polite">
          <span class="mb-app" id="mbApp">Finder</span>
          <span class="mb-menus">File&nbsp;&nbsp;Edit&nbsp;&nbsp;View&nbsp;&nbsp;Go&nbsp;&nbsp;Window&nbsp;&nbsp;Help</span>
          <span class="mb-spacer"></span>
          <span class="mb-tracker" id="mbTracker">
            <canvas id="mbEye" aria-hidden="true"></canvas>
            <span id="mbTask">watching&hellip;</span>
            <span id="mbClock" class="tnum">00:00</span>
            <span id="mbCert" class="tnum">&ndash;</span>
          </span>
          <span class="mb-sys tnum">Tue&nbsp;9:41</span>
        </div>
        <div class="desktop" id="desktop">
          <button class="app-card" data-app="mail" aria-label="Switch to the browser, reading client email">
            <span class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="wtitle">webmail &ndash; inbox</span></span>
            <span class="app-body">
              <span class="urlbar">mail.client.example</span>
              <span class="mail-cols">
                <span class="rail"><i class="pill"></i><i class="rl"></i><i class="rl"></i><i class="rl"></i></span>
                <span class="mlist">
                  <span class="mrow unread"><i class="frm"></i><i class="subj"></i></span>
                  <span class="mrow"><i class="frm"></i><i class="subj"></i></span>
                  <span class="mrow unread"><i class="frm"></i><i class="subj"></i></span>
                  <span class="mrow"><i class="frm"></i><i class="subj"></i></span>
                </span>
              </span>
            </span>
          </button>
          <button class="app-card" data-app="code" aria-label="Switch to the code editor">
            <span class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="wtitle">TrackerCore.swift &ndash; andeyeTT</span></span>
            <span class="app-body">
              <span class="code-lines">
                <span class="cl"><b></b><i></i></span>
                <span class="cl"><b></b><i></i></span>
                <span class="cl"><b></b><i></i></span>
                <span class="cl"><b></b><i></i></span>
                <span class="cl"><b></b><i></i></span>
                <span class="cl"><b></b><i></i></span>
                <span class="cl"><b></b><i></i></span>
              </span>
            </span>
          </button>
          <button class="app-card" data-app="design" aria-label="Switch to the design canvas">
            <span class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="wtitle">brand-refresh-v3</span></span>
            <span class="app-body">
              <span class="canvas-area">
                <span class="tools"><i></i><i></i><i></i><i></i></span>
                <span class="board">
                  <span class="shape circle"></span>
                  <span class="shape rect"></span>
                  <span class="shape line"></span>
                </span>
              </span>
            </span>
          </button>
          <button class="app-card" data-app="term" aria-label="Switch to the terminal">
            <span class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="wtitle">deploy &ndash; zsh</span></span>
            <span class="app-body">
              <span class="term">
                <span class="trow"><s>$</s><i></i></span>
                <span class="trow"><i></i></span>
                <span class="trow"><i></i></span>
                <span class="trow"><s>$</s><span class="cursor"></span></span>
              </span>
            </span>
          </button>
        </div>
      </div>
      <div class="timeline">
        <div class="tl-head"><span>attributed in this demo</span><span id="tlTotal" class="tnum">0:00</span></div>
        <div class="tl-strip" id="tlStrip" aria-hidden="true"></div>
        <p class="tl-key">Each block is one stretch on one task. Block colour = the eye's certainty at the time.</p>
      </div>
    </div>
  </div>
</header>

<section id="how">
  <div class="wrap">
    <p class="eyebrow">How it works</p>
    <h2>Three moves, all on your Mac</h2>
    <div class="steps">
      <div class="step">
        <span class="num">01 &ndash; OBSERVE</span>
        <h3>It reads the room</h3>
        <p>andeye watches your active window and tab title as you work. That is the whole feed &ndash; no screenshots, no keystrokes, and nothing ever sent anywhere.</p>
      </div>
      <div class="step">
        <span class="num">02 &ndash; ATTRIBUTE</span>
        <h3>Every minute finds its task</h3>
        <p>Each minute lands on a task with an honest certainty score. 97% sure you were on issue #142; 74% sure that terminal session was the deploy. It tells you, and it never rounds up.</p>
      </div>
      <div class="step">
        <span class="num">03 &ndash; POST</span>
        <h3>Your backlog fills itself in</h3>
        <p>Confirmed time posts to your own backlog &ndash; OpenProject today, more connectors to come. You keep the final say on every entry.</p>
      </div>
    </div>
  </div>
</section>

<section class="privacy" id="privacy">
  <div class="wrap">
    <canvas id="pvEye" aria-hidden="true"></canvas>
    <p class="eyebrow">Privacy</p>
    <h2>It watches for you.<br>Not on you.</h2>
    <p class="lede">Most tracking software points the camera at the worker and hands the film to someone else. andeye inverts that: the eye answers to the person it watches, and to no one else.</p>
    <div class="pv-claims">
      <div>
        <h3>Nothing leaves your Mac.</h3>
        <p>Observation, attribution and learning all run on-device. There is no server, no account, no telemetry &ndash; nowhere for your day to go.</p>
      </div>
      <div>
        <h3>Learning stays local.</h3>
        <p>The model of how you work is built on your Mac and lives on your Mac. It gets smarter about you without anyone else getting smarter about you.</p>
      </div>
      <div>
        <h3>Your rules, on your disk.</h3>
        <p>Pin rules like &ldquo;mail from this client goes to this project&rdquo; are files in your home folder. Read them, edit them, delete them.</p>
      </div>
    </div>
  </div>
</section>

<section id="community">
  <div class="wrap">
    <p class="eyebrow">Community &amp; Pro</p>
    <h2>Open where it matters</h2>
    <div class="tiers">
      <div class="tier">
        <span class="tag">Community &middot; AGPL-3.0</span>
        <h3>The tracker is free software</h3>
        <p>The macOS app is open source under AGPL-3.0. Clone the repo and build it today &ndash; observation, attribution, certainty scores and the OpenProject connector, all included.</p>
        <a href="https://github.com/andeyePro/andeyeTT">Star on GitHub &rarr;</a>
      </div>
      <div class="tier pro">
        <span class="tag">andeyePro &middot; later</span>
        <h3>Paid connectivity, when it's ready</h3>
        <p>andeyePro adds the paid extras: Xero and friends, plus an iPhone companion. The tracker itself stays free, local and yours.</p>
        <a href="mailto:hello@andeye.com?subject=andeye%20waitlist">Join the waitlist &rarr;</a>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <span>&copy; andeye Ltd &middot; SC665704 &middot; Scotland</span>
    <nav>
      <a href="/manual">Manual</a>
      <a href="https://github.com/andeyePro/andeyeTT">GitHub</a>
      <a href="mailto:hello@andeye.com?subject=andeye%20waitlist">hello@andeye.com</a>
    </nav>
  </div>
</footer>

<script is:inline>
(function () {
'use strict';

// --- geometry begin (literal port of Sources/AndeyeTTCore/AndeyeLogo.swift,
//     verbatim from the verified logo-preview) ---

// SVG viewBox is 365 x 235; everything normalises by the WIDTH, so the
// mark lives in a box 1 wide and `aspect` tall (y up).
const aspect = 235.0 / 365.0;

// Stroke width from the SVG (17px on a 365-wide viewBox), as a fraction
// of the box width.
const strokeWidth = 17.0 / 365.0;

// The SVG's group transform: translate(18.0915, 17.9436).
const translate = { x: 18.0915, y: 17.9436 };

// d="M145,157 C-95,-27 177,-2 59,76 C-37.95,140.08 54,236 122,137
//    C205.86,14.91 311,137 311,137 C311,137 232,221 145,157 Z"
// (Z is degenerate: the last cubic already returns to the M point.)
// Each entry: [p0, c1, c2, p1] as {x, y}.
function P(x, y) { return { x: x, y: y }; }
const svgCubics = [
  [P(145, 157), P(-95, -27), P(177, -2), P(59, 76)],
  [P(59, 76), P(-37.95, 140.08), P(54, 236), P(122, 137)],
  [P(122, 137), P(205.86, 14.91), P(311, 137), P(311, 137)],
  [P(311, 137), P(311, 137), P(232, 221), P(145, 157)],
];

// SVG user space (y down) -> unit-width box (y up).
function normalised(p) {
  return P((p.x + translate.x) / 365.0,
           (235.0 - (p.y + translate.y)) / 365.0);
}

// Closed-eye pose (SVG space): only the lid segments' control points move.
// Endpoints (the eye's corners) and the whole left side stay fixed; the top
// lid comes down a lot, the bottom lid rises a little, and at wink 1 both
// lie along the same gentle smile arc (they render as one line).
const topLidClosed = { c1: P(171.03, 187.18), c2: P(258.9, 178.05) };
const bottomLidClosed = { c1: P(311, 141), c2: P(232, 196) };

function clamp01(v) { return Math.min(Math.max(v, 0), 1); }

// The complete mark at blink amount `wink` (0 open ... 1 shut): an eyelid
// close, not a squash — mirrors AndeyeLogo.fullStroke(wink:).
function fullStroke(wink) {
  const w = clamp01(wink);
  const lerp = (a, b) => P(a.x + (b.x - a.x) * w, a.y + (b.y - a.y) * w);
  const svg = svgCubics.map(c => c.slice());
  svg[2][1] = lerp(svg[2][1], topLidClosed.c1);
  svg[2][2] = lerp(svg[2][2], topLidClosed.c2);
  svg[3][1] = lerp(svg[3][1], bottomLidClosed.c1);
  svg[3][2] = lerp(svg[3][2], bottomLidClosed.c2);
  return svg.map(c => ({
    p0: normalised(c[0]), c1: normalised(c[1]), c2: normalised(c[2]), p1: normalised(c[3]),
  }));
}

// The mark revealed by arc length from its M point.
function stroke(rawT, rawWink) {
  const t = clamp01(rawT);
  const wink = clamp01(rawWink);
  return revealed(fullStroke(wink), t);
}

function pointOn(c, u) {
  const v = 1 - u;
  const a = v * v * v, b = 3 * v * v * u, d = 3 * v * u * u, e = u * u * u;
  return P(a * c.p0.x + b * c.c1.x + d * c.c2.x + e * c.p1.x,
           a * c.p0.y + b * c.c1.y + d * c.c2.y + e * c.p1.y);
}

// Flattened (24-sample) arc length.
function lengthOfCubic(c) {
  let total = 0.0;
  let prev = c.p0;
  for (let i = 1; i <= 24; i++) {
    const p = pointOn(c, i / 24);
    total += Math.sqrt((p.x - prev.x) * (p.x - prev.x)
      + (p.y - prev.y) * (p.y - prev.y));
    prev = p;
  }
  return total;
}

function lengthOfSegs(segs) {
  return segs.reduce((acc, s) => acc + lengthOfCubic(s), 0);
}

// Leading part of `c` up to parameter `u` (de Casteljau split).
function splitCubic(c, u) {
  function lerp(a, b) {
    return P(a.x + (b.x - a.x) * u, a.y + (b.y - a.y) * u);
  }
  const q0 = lerp(c.p0, c.c1), q1 = lerp(c.c1, c.c2), q2 = lerp(c.c2, c.p1);
  const r0 = lerp(q0, q1), r1 = lerp(q1, q2);
  return { p0: c.p0, c1: q0, c2: r0, p1: lerp(r0, r1) };
}

// Parameter u whose leading arc length is `target` (sample-walked).
function parameterForArcLength(target, c) {
  if (!(target > 0)) return 0;
  let acc = 0.0;
  let prev = c.p0;
  for (let i = 1; i <= 24; i++) {
    const u = i / 24;
    const p = pointOn(c, u);
    const step = Math.sqrt((p.x - prev.x) * (p.x - prev.x)
      + (p.y - prev.y) * (p.y - prev.y));
    if (acc + step >= target) {
      const inside = step > 0 ? (target - acc) / step : 0;
      return u - (1 - inside) / 24;
    }
    acc += step;
    prev = p;
  }
  return 1;
}

// First `fraction` of the path's total arc length, ending mid-segment
// via a bezier split so the reveal front moves smoothly.
function revealed(segs, fraction) {
  if (!(fraction > 0)) return [];
  if (!(fraction < 1)) return segs;
  const target = fraction * lengthOfSegs(segs);
  const out = [];
  let acc = 0.0;
  for (const seg of segs) {
    const l = lengthOfCubic(seg);
    if (acc + l >= target) {
      const u = parameterForArcLength(target - acc, seg);
      if (u > 1e-6) out.push(splitCubic(seg, u));
      return out;
    }
    out.push(seg);
    acc += l;
  }
  return segs;
}
// --- geometry end ---

// --- rendering (literal port of AndeyeLogoImage.swift, y flipped for canvas) ---

// Draws `segs` (unit-width box coords, y up) into ctx sized cssW x cssH,
// exactly as the Mac drawing handler does: inset the rect by half the
// stroke, uniform-fit the 1 x aspect box, round caps/joins.
function drawMark(ctx, cssW, cssH, segs, colour) {
  ctx.clearRect(0, 0, cssW, cssH);
  if (segs.length === 0) return;
  const lineWidthForInset = cssW * strokeWidth;
  const insetW = cssW - lineWidthForInset;
  const insetH = cssH - lineWidthForInset;
  const scale = Math.min(insetW, insetH / aspect);
  const originX = cssW / 2 - scale / 2;               // inset.midX - scale/2
  const originY = cssH / 2 - scale * aspect / 2;      // inset.midY - ... (y up)
  // y-up -> canvas y-down: yCanvas = cssH - (originY + scale * p.y)
  function atX(p) { return originX + scale * p.x; }
  function atY(p) { return cssH - (originY + scale * p.y); }
  ctx.beginPath();
  ctx.moveTo(atX(segs[0].p0), atY(segs[0].p0));
  for (const seg of segs) {
    ctx.bezierCurveTo(atX(seg.c1), atY(seg.c1),
                      atX(seg.c2), atY(seg.c2),
                      atX(seg.p1), atY(seg.p1));
  }
  ctx.lineWidth = scale * strokeWidth;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.strokeStyle = colour;
  ctx.stroke();
}

// --- colour: the certainty gradient (the app's honest-confidence signal) ---

const NEUTRAL = [174, 182, 196];              // before the eye knows anything
const LOW = [106, 115, 130];                  // unsure: cool slate
const ACC = [240, 161, 58];                   // sure: dusk amber
function mixRGB(a, b, k) {
  return [Math.round(a[0] + (b[0] - a[0]) * k),
          Math.round(a[1] + (b[1] - a[1]) * k),
          Math.round(a[2] + (b[2] - a[2]) * k)];
}
function cssRGB(c) { return 'rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')'; }
function certRGB(cert) {
  const k = clamp01((cert - 0.65) / 0.35);
  return mixRGB(LOW, ACC, k);
}

// --- the living eye: one state, rendered to hero + menu bar together ---

const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const dpr = Math.max(window.devicePixelRatio || 1, 1);

const state = { t: reduced ? 1.0 : 0.0, wink: 0.0, rgb: NEUTRAL.slice() };
let animTimer = null;
let colourRaf = null;
let blinkTimer = null;

const heroEye = document.getElementById('heroEye');
const mbEye = document.getElementById('mbEye');
const pvEye = document.getElementById('pvEye');
const heroCtx = heroEye.getContext('2d');
const mbCtx = mbEye.getContext('2d');

let HERO_W = 340, HERO_H = Math.round(HERO_W * aspect);
const MB_H = 16, MB_W = Math.round(MB_H / aspect);

function sizeCanvas(cv, ctx, w, h) {
  cv.width = w * dpr; cv.height = h * dpr;
  cv.style.width = w + 'px'; cv.style.height = h + 'px';
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}

function sizeAll() {
  const avail = heroEye.parentElement.clientWidth || 340;
  HERO_W = Math.min(340, avail);
  HERO_H = Math.round(HERO_W * aspect);
  sizeCanvas(heroEye, heroCtx, HERO_W, HERO_H);
  sizeCanvas(mbEye, mbCtx, MB_W, MB_H);
  render();
}

function render() {
  const segs = stroke(state.t, state.wink);
  const col = cssRGB(state.rgb);
  drawMark(heroCtx, HERO_W, HERO_H, segs, col);
  drawMark(mbCtx, MB_W, MB_H, segs, col);
}

function cancelAnim() {
  if (animTimer !== null) { clearTimeout(animTimer); animTimer = null; }
}

// Draw-on: t stepping 0 -> 1 in 16 steps at 75 ms/frame (~1.2 s),
// mirroring AppController.playDrawOn.
function playDrawOn(done) {
  cancelAnim();
  const steps = 16;
  let i = 0;
  function frame() {
    state.t = i / steps;
    render();
    if (i < steps) { i++; animTimer = setTimeout(frame, 75); }
    else { animTimer = null; if (done) done(); }
  }
  frame();
}

// Wink: [1.0, 0.45, 0.0] at 120 ms/frame (shut -> half -> open, ~360 ms),
// mirroring AppController.playWink. Only winks once fully drawn.
function playWink(done) {
  if (reduced) { if (done) done(); return; }
  cancelAnim();
  state.t = 1;
  const frames = [1.0, 0.45, 0.0];
  let i = 0;
  function frame() {
    state.wink = frames[i];
    render();
    i++;
    if (i < frames.length) animTimer = setTimeout(frame, 120);
    else { animTimer = null; if (done) done(); }
  }
  frame();
}

// Certainty tint: blend the eye's colour over ~550 ms.
function tintTo(target, instant) {
  if (colourRaf !== null) { cancelAnimationFrame(colourRaf); colourRaf = null; }
  if (instant || reduced) { state.rgb = target.slice(); render(); return; }
  const from = state.rgb.slice();
  const start = performance.now();
  const dur = 550;
  function step(now) {
    const k = clamp01((now - start) / dur);
    const e = k * (2 - k); // ease-out
    state.rgb = mixRGB(from, target, e);
    render();
    if (k < 1) colourRaf = requestAnimationFrame(step);
    else colourRaf = null;
  }
  colourRaf = requestAnimationFrame(step);
}

// Idle blinks: the eye is alive even when nothing happens.
function scheduleBlink() {
  if (reduced) return;
  clearTimeout(blinkTimer);
  blinkTimer = setTimeout(function () {
    if (animTimer === null && document.visibilityState === 'visible') playWink();
    scheduleBlink();
  }, 4800 + Math.random() * 4600);
}

// --- the demo: a day at your Mac ---

const APPS = {
  mail:   { app: 'Browser',  task: 'Acme Ltd · redesign thread', cert: 0.92 },
  code:   { app: 'Code',     task: 'andeyeTT · issue #142',      cert: 0.97 },
  design: { app: 'Canvas',   task: 'Brand refresh · v3',         cert: 0.88 },
  term:   { app: 'Terminal', task: 'Deploy · pipeline fix',      cert: 0.74 },
};

const mbApp = document.getElementById('mbApp');
const mbTask = document.getElementById('mbTask');
const mbClock = document.getElementById('mbClock');
const mbCert = document.getElementById('mbCert');
const mbTracker = document.getElementById('mbTracker');
const tlStrip = document.getElementById('tlStrip');
const tlTotal = document.getElementById('tlTotal');
const driveState = document.getElementById('driveState');
const cards = Array.prototype.slice.call(document.querySelectorAll('.app-card'));

let currentTask = null;      // committed task id
let currentFocus = null;     // focused window id
let taskStart = 0;           // performance.now() at last commit
let pendingTimer = null;
let doneSeconds = 0;         // finished blocks total
let curBlock = null;

function fmtClock(s) {
  s = Math.max(0, Math.floor(s));
  const m = Math.floor(s / 60);
  const ss = ('0' + (s % 60)).slice(-2);
  return ('0' + m).slice(-2) + ':' + ss;
}
function fmtTotal(s) {
  s = Math.max(0, Math.floor(s));
  return Math.floor(s / 60) + ':' + ('0' + (s % 60)).slice(-2);
}

function setFocus(id) {
  currentFocus = id;
  mbApp.textContent = APPS[id].app;
  cards.forEach(function (c) {
    c.classList.toggle('active', c.getAttribute('data-app') === id);
  });
}

function commit(id, instant) {
  const now = performance.now();
  if (currentTask !== null) doneSeconds += (now - taskStart) / 1000;
  currentTask = id;
  taskStart = now;
  const a = APPS[id];
  mbTask.textContent = a.task;
  mbClock.textContent = '00:00';
  mbCert.textContent = Math.round(a.cert * 100) + '%';
  const rgb = certRGB(a.cert);
  mbCert.style.color = cssRGB(rgb);
  tintTo(rgb, instant);
  if (!instant) { playWink(); scheduleBlink(); }
  // new timeline block for the new stretch
  curBlock = document.createElement('div');
  curBlock.className = 'tl-block';
  curBlock.style.background = cssRGB(rgb);
  curBlock.style.flexGrow = 1;
  tlStrip.appendChild(curBlock);
}

function switchTo(id, instant) {
  if (id === currentFocus && id === currentTask) return;
  setFocus(id);
  clearTimeout(pendingTimer);
  if (instant) { commit(id, true); return; }
  // the attribution beat: focus is instant, attribution takes a moment
  mbTracker.classList.add('attributing');
  pendingTimer = setTimeout(function () {
    mbTracker.classList.remove('attributing');
    commit(id, false);
  }, 700);
}

setInterval(function () {
  if (currentTask === null) return;
  const s = (performance.now() - taskStart) / 1000;
  mbClock.textContent = fmtClock(s);
  if (curBlock) curBlock.style.flexGrow = Math.max(s, 1);
  tlTotal.textContent = fmtTotal(doneSeconds + s);
}, 250);

// --- autoplay: a scripted loop until the visitor takes over ---

const AUTO_ORDER = ['mail', 'code', 'design', 'term'];
let autoIdx = 0;
let autoTimer = null;
let driving = false;

function autoStep() {
  const id = AUTO_ORDER[autoIdx % AUTO_ORDER.length];
  autoIdx++;
  const card = cards.find(function (c) { return c.getAttribute('data-app') === id; });
  if (card && !reduced) {
    card.classList.remove('autopulse');
    void card.offsetWidth;
    card.classList.add('autopulse');
  }
  switchTo(id, false);
  autoTimer = setTimeout(autoStep, 3800);
}

function stopAuto() {
  if (driving) return;
  driving = true;
  clearTimeout(autoTimer);
  driveState.textContent = "you're driving · the eye follows you now";
  driveState.classList.add('driving');
}

cards.forEach(function (card) {
  card.addEventListener('click', function (e) {
    if (e.isTrusted) stopAuto();
    switchTo(card.getAttribute('data-app'), false);
  });
});

// --- decorative privacy mark (static, fully drawn) ---

function drawStaticMark(cv, w, colour) {
  const h = Math.round(w * aspect);
  const ctx = cv.getContext('2d');
  sizeCanvas(cv, ctx, w, h);
  drawMark(ctx, w, h, stroke(1, 0), colour);
}

// --- CTA hover: the eye winks back ---

let lastCtaWink = 0;
document.getElementById('ctaWaitlist').addEventListener('mouseenter', function () {
  const now = performance.now();
  if (reduced || animTimer !== null || now - lastCtaWink < 2500) return;
  lastCtaWink = now;
  playWink();
});

// --- load choreography: one orchestrated sequence ---
// dark -> the eye draws itself on -> one wink -> the words arrive -> the
// demo starts working on its own. Reduced motion: everything is simply there.

function revealAll() {
  document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
}

sizeAll();
drawStaticMark(pvEye, 72, 'rgba(240,161,58,0.9)');
window.addEventListener('resize', function () {
  sizeAll();
  drawStaticMark(pvEye, 72, 'rgba(240,161,58,0.9)');
});

if (reduced) {
  state.t = 1;
  render();
  revealAll();
  setFocus('mail');
  commit('mail', true);
  driveState.textContent = 'click any window to switch task';
} else {
  playDrawOn(function () {
    setTimeout(function () { playWink(); }, 180);
    setTimeout(revealAll, 620);
    setTimeout(function () { autoStep(); scheduleBlink(); }, 1500);
  });
}

})();
</script>
