<script is:inline>
(function () {
'use strict';

// --- geometry begin (literal port of Sources/andeyeTTCore/AndeyeLogo.swift,
//     verbatim from the verified logo-preview) ---

// SVG viewBox is 365 x 235; everything normalises by the WIDTH, so the
// mark lives in a box 1 wide and `aspect` tall (y up).
const aspect = 235.0 / 365.0;

// Stroke width from the SVG (17px on a 365-wide viewBox), as a fraction
// of the box width.
const strokeWidth = 17.0 / 365.0;

// The SVG's group transform: translate(18.0915, 17.9436).
const translate = { x: 18.0915, y: 17.9436 };

// d="M145,157 C-95,-27 177,-2 59,76 C-37.95,140.08 54,236 122,137
//    C205.86,14.91 311,137 311,137 C311,137 232,221 145,157 Z"
// (Z is degenerate: the last cubic already returns to the M point.)
// Each entry: [p0, c1, c2, p1] as {x, y}.
function P(x, y) { return { x: x, y: y }; }
const svgCubics = [
  [P(145, 157), P(-95, -27), P(177, -2), P(59, 76)],
  [P(59, 76), P(-37.95, 140.08), P(54, 236), P(122, 137)],
  [P(122, 137), P(205.86, 14.91), P(311, 137), P(311, 137)],
  [P(311, 137), P(311, 137), P(232, 221), P(145, 157)],
];

// SVG user space (y down) -> unit-width box (y up).
function normalised(p) {
  return P((p.x + translate.x) / 365.0,
           (235.0 - (p.y + translate.y)) / 365.0);
}

// Closed-eye pose (SVG space): only the lid segments' control points move.
// Endpoints (the eye's corners) and the whole left side stay fixed; the top
// lid comes down a lot, the bottom lid rises a little, and at wink 1 both
// lie along the same gentle smile arc (they render as one line).
const topLidClosed = { c1: P(171.03, 187.18), c2: P(258.9, 178.05) };
const bottomLidClosed = { c1: P(311, 141), c2: P(232, 196) };

function clamp01(v) { return Math.min(Math.max(v, 0), 1); }

// The complete mark at blink amount `wink` (0 open ... 1 shut): an eyelid
// close, not a squash — mirrors AndeyeLogo.fullStroke(wink:).
function fullStroke(wink) {
  const w = clamp01(wink);
  const lerp = (a, b) => P(a.x + (b.x - a.x) * w, a.y + (b.y - a.y) * w);
  const svg = svgCubics.map(c => c.slice());
  svg[2][1] = lerp(svg[2][1], topLidClosed.c1);
  svg[2][2] = lerp(svg[2][2], topLidClosed.c2);
  svg[3][1] = lerp(svg[3][1], bottomLidClosed.c1);
  svg[3][2] = lerp(svg[3][2], bottomLidClosed.c2);
  return svg.map(c => ({
    p0: normalised(c[0]), c1: normalised(c[1]), c2: normalised(c[2]), p1: normalised(c[3]),
  }));
}

// The mark revealed by arc length from its M point.
function stroke(rawT, rawWink) {
  const t = clamp01(rawT);
  const wink = clamp01(rawWink);
  return revealed(fullStroke(wink), t);
}

function pointOn(c, u) {
  const v = 1 - u;
  const a = v * v * v, b = 3 * v * v * u, d = 3 * v * u * u, e = u * u * u;
  return P(a * c.p0.x + b * c.c1.x + d * c.c2.x + e * c.p1.x,
           a * c.p0.y + b * c.c1.y + d * c.c2.y + e * c.p1.y);
}

// Flattened (24-sample) arc length.
function lengthOfCubic(c) {
  let total = 0.0;
  let prev = c.p0;
  for (let i = 1; i <= 24; i++) {
    const p = pointOn(c, i / 24);
    total += Math.sqrt((p.x - prev.x) * (p.x - prev.x)
      + (p.y - prev.y) * (p.y - prev.y));
    prev = p;
  }
  return total;
}

function lengthOfSegs(segs) {
  return segs.reduce((acc, s) => acc + lengthOfCubic(s), 0);
}

// Leading part of `c` up to parameter `u` (de Casteljau split).
function splitCubic(c, u) {
  function lerp(a, b) {
    return P(a.x + (b.x - a.x) * u, a.y + (b.y - a.y) * u);
  }
  const q0 = lerp(c.p0, c.c1), q1 = lerp(c.c1, c.c2), q2 = lerp(c.c2, c.p1);
  const r0 = lerp(q0, q1), r1 = lerp(q1, q2);
  return { p0: c.p0, c1: q0, c2: r0, p1: lerp(r0, r1) };
}

// Parameter u whose leading arc length is `target` (sample-walked).
function parameterForArcLength(target, c) {
  if (!(target > 0)) return 0;
  let acc = 0.0;
  let prev = c.p0;
  for (let i = 1; i <= 24; i++) {
    const u = i / 24;
    const p = pointOn(c, u);
    const step = Math.sqrt((p.x - prev.x) * (p.x - prev.x)
      + (p.y - prev.y) * (p.y - prev.y));
    if (acc + step >= target) {
      const inside = step > 0 ? (target - acc) / step : 0;
      return u - (1 - inside) / 24;
    }
    acc += step;
    prev = p;
  }
  return 1;
}

// First `fraction` of the path's total arc length, ending mid-segment
// via a bezier split so the reveal front moves smoothly.
function revealed(segs, fraction) {
  if (!(fraction > 0)) return [];
  if (!(fraction < 1)) return segs;
  const target = fraction * lengthOfSegs(segs);
  const out = [];
  let acc = 0.0;
  for (const seg of segs) {
    const l = lengthOfCubic(seg);
    if (acc + l >= target) {
      const u = parameterForArcLength(target - acc, seg);
      if (u > 1e-6) out.push(splitCubic(seg, u));
      return out;
    }
    out.push(seg);
    acc += l;
  }
  return segs;
}
// --- geometry end ---

// --- rendering (literal port of AndeyeLogoImage.swift, y flipped for canvas) ---

// Draws `segs` (unit-width box coords, y up) into ctx sized cssW x cssH,
// exactly as the Mac drawing handler does: inset the rect by half the
// stroke, uniform-fit the 1 x aspect box, round caps/joins.
function drawMark(ctx, cssW, cssH, segs, colour) {
  ctx.clearRect(0, 0, cssW, cssH);
  if (segs.length === 0) return;
  const lineWidthForInset = cssW * strokeWidth;
  const insetW = cssW - lineWidthForInset;
  const insetH = cssH - lineWidthForInset;
  const scale = Math.min(insetW, insetH / aspect);
  const originX = cssW / 2 - scale / 2;               // inset.midX - scale/2
  const originY = cssH / 2 - scale * aspect / 2;      // inset.midY - ... (y up)
  // y-up -> canvas y-down: yCanvas = cssH - (originY + scale * p.y)
  function atX(p) { return originX + scale * p.x; }
  function atY(p) { return cssH - (originY + scale * p.y); }
  ctx.beginPath();
  ctx.moveTo(atX(segs[0].p0), atY(segs[0].p0));
  for (const seg of segs) {
    ctx.bezierCurveTo(atX(seg.c1), atY(seg.c1),
                      atX(seg.c2), atY(seg.c2),
                      atX(seg.p1), atY(seg.p1));
  }
  ctx.lineWidth = scale * strokeWidth;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.strokeStyle = colour;
  ctx.stroke();
}

// --- colour: the certainty gradient (the app's honest-confidence signal) ---
// VERBATIM from MenuTitle.colour: a linear blend of the user's two gradient
// colours — default #FF3B30 (systemRed) at certainty 0 -> #34C759
// (systemGreen) at certainty 1. RED means unsure, GREEN means sure.
// ONLY the menu-bar mark carries this; the hero mark stays orange.

const NEUTRAL = [142, 142, 147];              // systemGray: before the eye knows anything
const CERT_LOW = [255, 59, 48];               // #FF3B30 systemRed — unsure
const CERT_HIGH = [52, 199, 89];              // #34C759 systemGreen — sure
const ACCENT = '#f0a13a';                     // the hero mark's fixed orange
function mixRGB(a, b, k) {
  return [Math.round(a[0] + (b[0] - a[0]) * k),
          Math.round(a[1] + (b[1] - a[1]) * k),
          Math.round(a[2] + (b[2] - a[2]) * k)];
}
function cssRGB(c) { return 'rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')'; }
function certRGB(cert) {
  return mixRGB(CERT_LOW, CERT_HIGH, clamp01(cert));
}

// --- project palette: the app's per-task colour (AppController.colour) is
// HSB(hue, 0.55, 0.85); we pick fixed hues in that exact saturation/brightness
// so the timeline slices and pie wedges read like the real app. ---
function hsb(h, s, v) {
  h = (h % 360) / 60;
  const c = v * s, x = c * (1 - Math.abs(h % 2 - 1)), m = v - c;
  let r = 0, g = 0, b = 0;
  if (h < 1) { r = c; g = x; }
  else if (h < 2) { r = x; g = c; }
  else if (h < 3) { g = c; b = x; }
  else if (h < 4) { g = x; b = c; }
  else if (h < 5) { r = x; b = c; }
  else { r = c; b = x; }
  return [Math.round((r + m) * 255), Math.round((g + m) * 255), Math.round((b + m) * 255)];
}

// Only client work is billable: your own books, your reading and your breaks
// are all honestly tracked, and honestly not on anyone's invoice.
const PROJECTS = {
  maren:    { label: 'Maren',     rgb: hsb(265, 0.55, 0.85), billable: true,  note: 'billable' },
  accounts: { label: 'Accounts',  rgb: hsb(205, 0.55, 0.85), billable: false, note: 'your books' },
  reading:  { label: 'Anthropic', rgb: hsb(338, 0.55, 0.85), billable: false, note: 'reading' },
  brk:      { label: 'Kittens',   rgb: hsb(150, 0.10, 0.62), billable: false, note: 'break' },
};
const PROJ_ORDER = ['maren', 'accounts', 'reading', 'brk'];

// --- the two eyes: HERO (always orange) and MENU-BAR (certainty-tinted) ---

const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const dpr = Math.max(window.devicePixelRatio || 1, 1);

const heroEye = document.getElementById('heroEye');
const mbEye = document.getElementById('mbEye');
const pvEye = document.getElementById('pvEye');
const heroCtx = heroEye.getContext('2d');
const mbCtx = mbEye.getContext('2d');

let HERO_W = 340, HERO_H = Math.round(HERO_W * aspect);
const MB_H = 16, MB_W = Math.round(MB_H / aspect);

function sizeCanvas(cv, ctx, w, h) {
  cv.width = w * dpr; cv.height = h * dpr;
  cv.style.width = w + 'px'; cv.style.height = h + 'px';
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}

// hero state: geometry only, colour is always ACCENT
let heroT = reduced ? 1 : 0, heroWink = 0, heroTimer = null, heroBlinkTimer = null;
function renderHero() { drawMark(heroCtx, HERO_W, HERO_H, stroke(heroT, heroWink), ACCENT); }

// menu-bar state: always fully drawn (t=1), winks on task change, tint = certainty
let mbWink = 0, mbTimer = null, mbRaf = null, mbRGB = NEUTRAL.slice();
function renderMB() { drawMark(mbCtx, MB_W, MB_H, stroke(1, mbWink), cssRGB(mbRGB)); }

function sizeAll() {
  const avail = heroEye.parentElement.clientWidth || 340;
  HERO_W = Math.min(340, avail);
  HERO_H = Math.round(HERO_W * aspect);
  sizeCanvas(heroEye, heroCtx, HERO_W, HERO_H);
  sizeCanvas(mbEye, mbCtx, MB_W, MB_H);
  renderHero();
  renderMB();
}

// Hero draw-on: t 0 -> 1 in 16 steps at 75 ms/frame (~1.2 s), mirroring
// AppController.playDrawOn. Then a hello wink, then idle blinks.
function heroDrawOn(done) {
  if (heroTimer !== null) { clearTimeout(heroTimer); heroTimer = null; }
  const steps = 16; let i = 0;
  (function frame() {
    heroT = i / steps; renderHero();
    if (i < steps) { i++; heroTimer = setTimeout(frame, 75); }
    else { heroTimer = null; if (done) done(); }
  })();
}
function heroWinkPlay(done) {
  if (reduced) { if (done) done(); return; }
  if (heroTimer !== null) { clearTimeout(heroTimer); heroTimer = null; }
  heroT = 1;
  const fr = [1.0, 0.45, 0.0]; let i = 0;
  (function frame() {
    heroWink = fr[i]; renderHero(); i++;
    if (i < fr.length) heroTimer = setTimeout(frame, 120);
    else { heroTimer = null; if (done) done(); }
  })();
}
function scheduleHeroBlink() {
  if (reduced) return;
  clearTimeout(heroBlinkTimer);
  heroBlinkTimer = setTimeout(function () {
    if (heroTimer === null && document.visibilityState === 'visible') heroWinkPlay();
    scheduleHeroBlink();
  }, 4800 + Math.random() * 4600);
}

// Menu-bar wink: [1.0, 0.45, 0.0] at 120 ms/frame – fires on every task change.
function mbWinkPlay() {
  if (reduced) return;
  if (mbTimer !== null) { clearTimeout(mbTimer); mbTimer = null; }
  const fr = [1.0, 0.45, 0.0]; let i = 0;
  (function frame() {
    mbWink = fr[i]; renderMB(); i++;
    if (i < fr.length) mbTimer = setTimeout(frame, 120);
    else { mbTimer = null; }
  })();
}

// Menu-bar certainty tint: blend the mark's colour over ~550 ms.
function tintMB(target, instant) {
  if (mbRaf !== null) { cancelAnimationFrame(mbRaf); mbRaf = null; }
  if (instant || reduced) { mbRGB = target.slice(); renderMB(); return; }
  const from = mbRGB.slice();
  const start = performance.now(), dur = 550;
  (function step(now) {
    const k = clamp01((now - start) / dur);
    const e = k * (2 - k); // ease-out
    mbRGB = mixRGB(from, target, e);
    renderMB();
    if (k < 1) mbRaf = requestAnimationFrame(step);
    else mbRaf = null;
  })(performance.now());
}

function drawStaticMark(cv, w, colour) {
  const h = Math.round(w * aspect);
  const ctx = cv.getContext('2d');
  sizeCanvas(cv, ctx, w, h);
  drawMark(ctx, w, h, stroke(1, 0), colour);
}

