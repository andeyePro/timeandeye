  sizeAll();
  drawStaticMark(pvEye, 72, 'rgba(240,161,58,0.9)');
  drawPie();
});

if (reduced) {
  heroT = 1; renderHero();
  revealAll();
} else {
  heroDrawOn(function () {
    setTimeout(function () { heroWinkPlay(); }, 180);
    setTimeout(revealAll, 620);
    setTimeout(scheduleHeroBlink, 1500);
  });
}

})();
</script>
</body>
</html>
